---
interface Props {
  id: string;
  label: string;
  rows?: number;
  hint?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  placeholder?: string;
  name?: string;
  class?: string;
}

const {
  id,
  label,
  rows = 4,
  hint,
  error,
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const describedBy =
  [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;
---

<div class="flex flex-col gap-2">
  <label for={id} class="otk-label">
    {label}
    {required && <span class="text-danger" aria-hidden="true"> *</span>}
  </label>
  <textarea
    id={id}
    rows={rows}
    required={required}
    disabled={disabled}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : undefined}
    class:list={["otk-input resize-y", error && "otk-input--invalid", className]}
    {...rest}
  ></textarea>
  {hint && <p id={`${id}-hint`} class="otk-help">{hint}</p>}
  {error && <p id={`${id}-error`} class="otk-error">{error}</p>}
</div>

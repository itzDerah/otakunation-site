---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  as?: "h1" | "h2" | "h3";
  align?: "start" | "center";
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  lede,
  as: Tag = "h2",
  align = "start",
  id,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-3",
    align === "center" && "items-center text-center",
    className,
  ]}
>
  {eyebrow && <p class="otk-eyebrow">{eyebrow}</p>}
  <Tag
    id={id}
    class:list={["text-title font-bold text-text", align === "center" && "text-balance"]}
  >
    {title}
  </Tag>
  {lede && (
    <p class:list={["otk-lede", align === "center" && "mx-auto text-balance"]}>{lede}</p>
  )}
  <span
    class:list={["otk-rule", align === "center" && "otk-rule--center"]}
    aria-hidden="true"
  ></span>
</div>

---
import { ArrowRight, Crown, Globe, Users } from "@lucide/astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import { asset } from "../../utils/paths";
import { site } from "../../data/site";

const pillars = [
  {
    icon: Users,
    label: "Community-first",
    detail: "Built with the culture",
  },
  {
    icon: Globe,
    label: "African roots",
    detail: "Global ambition",
  },
  {
    icon: Crown,
    label: "More than a platform",
    detail: "A digital nation",
  },
];

const heroArtwork = asset("/brand/artwork/hero-castle-original.jpg");
---

<section
  class="relative border-b border-border bg-bg"
  aria-labelledby="hero-title"
>
  <div class="relative isolate overflow-hidden">
    <div
      class="otk-hero-media relative h-60 overflow-hidden sm:h-[20rem] lg:absolute lg:inset-0 lg:h-full"
      aria-hidden="true"
    >
      <img
        src={heroArtwork}
        alt=""
        width="1568"
        height="628"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 size-full object-cover object-[36%_center] lg:object-left"
      />

      <!-- Desktop: cinematic scrim that follows the active theme. -->
      <div class="otk-hero-scrim absolute inset-0 hidden lg:block"></div>

      <!-- Mobile: blend the carefully cropped landscape into the page. -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-ink-950/30 via-transparent to-transparent lg:hidden"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-bg via-bg/40 to-transparent lg:hidden"
      >
      </div>
    </div>

    <div
      class="otk-corners otk-hero-frame pointer-events-none absolute z-10 hidden lg:block"
      aria-hidden="true"
    >
    </div>

    <Container class="relative pt-10 pb-10 sm:pt-14 sm:pb-12 lg:pt-24 lg:pb-16 xl:pt-28 xl:pb-20">
      <div class="otk-hero-copy min-w-0 max-w-2xl">
        <p class="otk-eyebrow otk-eyebrow-line">A nation beyond imagination</p>

        <h1
          id="hero-title"
          class="mt-6 text-hero font-extrabold uppercase whitespace-nowrap text-text"
          aria-label="Otakunation"
        >
          <span aria-hidden="true">OTAKU</span><span class="text-accent" aria-hidden="true"
            >NATION</span
          >
        </h1>

        <p class="mt-4 max-w-xl text-balance text-display-sm font-bold text-text">
          The World&rsquo;s First Anime Nation
        </p>

        <p class="otk-lede mt-6">
          A digital nation where anime, creativity, technology and community meet — built
          for Otakus everywhere.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href="#ecosystem" size="lg" class="w-full sm:w-auto">
            Explore the ecosystem
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
          <Button
            href="#about"
            variant="secondary"
            size="lg"
            class="w-full sm:w-auto"
          >
            Read our story
          </Button>
        </div>

        <p class="mt-5 inline-flex items-center gap-2 text-xs text-text-subtle">
          <span class="otk-status-dot" aria-hidden="true"></span>
          {site.status} · Community registration pending
        </p>
      </div>
    </Container>

    <div
      class="otk-hero-plate pointer-events-none absolute right-8 bottom-8 z-10 hidden items-center gap-3 px-3 py-2 lg:flex"
      aria-hidden="true"
    >
      <span class="h-px w-6 bg-gold"></span>
      <span class="text-[0.6rem] font-semibold tracking-[0.22em] uppercase">
        The nation awaits
      </span>
      <span class="text-[0.6rem] tracking-[0.3em] text-gold" lang="ja">オタクの国</span>
    </div>
  </div>
</section>
---
import { ArrowRight, BookOpen, Megaphone, Users } from "@lucide/astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Container from "../ui/Container.astro";

const topics = [
  {
    icon: Megaphone,
    title: "Platform milestones",
    body: "Meaningful development notes, shared once they are confirmed.",
  },
  {
    icon: BookOpen,
    title: "Ecosystem previews",
    body: "Early looks at the six planned areas as they take shape.",
  },
  {
    icon: Users,
    title: "Community dispatches",
    body: "News from the people and culture at the centre of the nation.",
  },
];
---

<section
  id="news"
  class="otk-section border-b border-border bg-bg-subtle"
  aria-labelledby="news-title"
>
  <Container>
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        eyebrow="News & updates"
        title="The first dispatch is on its way."
        lede="Platform milestones, ecosystem previews and community news will live here. Nothing is published until it is verified."
        as="h2"
        id="news-title"
        size="lg"
        class="max-w-2xl"
      />

      <div class="flex max-w-sm items-center gap-3 border border-border bg-bg px-4 py-3">
        <span class="otk-status-dot" aria-hidden="true"></span>
        <p class="text-xs leading-relaxed text-text-muted">
          <span class="font-semibold text-text">News feed: preparing.</span>
          {" "}No public announcements yet.
        </p>
      </div>
    </div>

    <div class="otk-corners relative mt-12 border border-border bg-bg p-6 sm:p-8">
      <div class="relative z-10 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Badge tone="neutral">
            <span class="size-1.5 rounded-full bg-gold" aria-hidden="true"></span>
            No public updates yet
          </Badge>

          <h3 class="mt-5 text-2xl font-bold leading-tight text-text sm:text-3xl">
            We publish news when there is news.
          </h3>
          <p class="mt-4 max-w-prose text-sm leading-relaxed text-text-muted">
            No articles, dates or milestones are being invented to fill this space. When
            Otakunation has a verified update, it will appear here first.
          </p>

          <Button href="#ecosystem" variant="secondary" size="sm" class="mt-6">
            See what&rsquo;s planned
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <ul class="divide-y divide-border border-y border-border">
            {
              topics.map(({ icon: Icon, title, body }) => (
                <li class="flex items-center justify-between gap-4 py-4">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="mt-0.5 grid size-8 shrink-0 place-items-center border border-gold/20 text-gold">
                      <Icon class="size-4" aria-hidden="true" />
                    </span>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-text">{title}</p>
                      <p class="mt-1 text-xs leading-relaxed text-text-muted">{body}</p>
                    </div>
                  </div>
                  <span class="shrink-0 text-[0.6rem] font-semibold tracking-[0.14em] text-text-subtle uppercase">
                    Awaiting
                  </span>
                </li>
              ))
            }
          </ul>

          <p class="mt-4 text-xs leading-relaxed text-text-subtle">
            Categories are placeholders. No dates or announcements are pre-filled.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>

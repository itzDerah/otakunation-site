---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/nav/SiteHeader.astro";
import SiteFooter from "../components/nav/SiteFooter.astro";
import Hero from "../components/home/Hero.astro";
import Vision from "../components/home/Vision.astro";
import Ecosystem from "../components/home/Ecosystem.astro";
import About from "../components/home/About.astro";
import News from "../components/home/News.astro";
import Opportunities from "../components/home/Opportunities.astro";
import CommunityCta from "../components/home/CommunityCta.astro";
import { site } from "../data/site";
---

<BaseLayout
  fullTitle="Otakunation — The World's First Anime Nation"
  description={site.description}
  image={site.seo.ogImage}
  imageAlt={site.seo.ogImageAlt}
>
  <SiteHeader links={site.nav} brandHref="#top" cta={site.headerCta} />

  <main id="main" tabindex="-1" class="focus:outline-none">
    <Hero />
    <Vision />
    <Ecosystem />
    <About />
    <News />
    <Opportunities />
    <CommunityCta />
  </main>

  <SiteFooter />
</BaseLayout>
